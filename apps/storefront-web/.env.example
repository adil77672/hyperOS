# Copy to .env.local for local development.

# Base URL of the running Node backend (apps/backend-server).
# Matches PORT in apps/backend-server/.env (default 3000).
NEXT_PUBLIC_API_BASE=http://localhost:3000

# Storefronts resolve their tenant from the Host header. Locally the backend
# has DEV_FALLBACK_TENANT_SLUG=cheesyone, so localhost resolves to the demo
# tenant automatically and this can stay blank. In production the browser's
# own host (cheesyone.example.com) does the resolution.
NEXT_PUBLIC_STOREFRONT_HOST=
