# Copy to .env for local development.
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------- database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hyperzod
DATABASE_SSL=false

# Non-BYPASSRLS role — every request handler. RLS applies.
DATABASE_APP_USER=app_runtime
DATABASE_APP_PASSWORD=app_runtime

# BYPASSRLS role — control plane only (host->tenant lookup, signup).
DATABASE_PLATFORM_USER=platform_admin
DATABASE_PLATFORM_PASSWORD=platform_admin

# Superuser, used only by `npm run db:schema` to create extensions and roles.
DATABASE_SUPERUSER=postgres
DATABASE_SUPERUSER_PASSWORD=postgres

# ------------------------------------------------------------------- redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# -------------------------------------------------------------------- auth
# Must be >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-replace-me-with-32-plus-characters
JWT_ISSUER=hyperzod-api
JWT_AUDIENCE=hyperzod-dashboard
JWT_ACCESS_TTL_SECONDS=43200
REFRESH_TTL_SECONDS=2592000
SESSION_TTL_SECONDS=2592000

# ------------------------------------------------------------ multitenancy
PLATFORM_ROOT_DOMAIN=example.com
DASHBOARD_HOST=admin.example.com
PLATFORM_CDN_HOST=cdn.example.com

# Local dev only: `localhost:3000` has no tenant subdomain, so fall back to
# this slug. Leave unset in any deployed environment — it would let any
# unresolvable Host land on a real tenant.
DEV_FALLBACK_TENANT_SLUG=cheesyone

# -------------------------------------------------------------------- misc
COOKIE_SECURE=false
SSE_BUFFER_MAX_EVENTS=200
SSE_HEARTBEAT_MS=15000
RATE_LIMIT_ENABLED=true
