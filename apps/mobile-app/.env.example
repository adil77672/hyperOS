# Copy to .env for local development. Expo reads EXPO_PUBLIC_* at build time.
#
# The API base the app calls. Choose per target:
#   - iOS simulator:      http://localhost:3100
#   - Android emulator:   http://10.0.2.2:3100   (emulator alias for host)
#   - Physical device:    http://<your-machine-LAN-IP>:3100  (e.g. 192.168.1.20)
#
# The backend must be reachable from the device/emulator on that address.
EXPO_PUBLIC_API_BASE=http://localhost:3100
