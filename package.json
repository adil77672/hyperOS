{
  "name": "hyperzod-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant white-label web ordering SaaS for coffee shops and restaurants.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace @hyperzod/shared-types && npm run build --workspace @hyperzod/backend-server",
    "dev": "npm run start:dev --workspace @hyperzod/backend-server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:schema": "npm run db:schema --workspace @hyperzod/backend-server",
    "db:seed": "npm run db:seed --workspace @hyperzod/backend-server",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  }
}
