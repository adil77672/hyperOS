{
  "name": "hyperzod-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant white-label web ordering SaaS for coffee shops and restaurants.",
  "workspaces": [
    "packages/*",
    "apps/backend-server",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace @hyperzod/shared-types && npm run build --workspace @hyperzod/backend-server",
    "build:web": "npm run build --workspace @hyperzod/web",
    "build:all": "npm run build && npm run build:web",

    "dev": "npm run start:dev --workspace @hyperzod/backend-server",
    "dev:backend": "npm run start:dev --workspace @hyperzod/backend-server",
    "dev:web": "npm run dev --workspace @hyperzod/web",
    "dev:mobile": "npm --prefix apps/mobile-app run start",

    "//dev:all": "Backend API + the single web app (all surfaces via route groups). Mobile runs in its own terminal.",
    "dev:all": "concurrently -n backend,web -c green,cyan \"npm:dev:backend\" \"npm:dev:web\"",

    "install:all": "npm install && npm --prefix apps/mobile-app install",

    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck:mobile": "npm --prefix apps/mobile-app run typecheck",

    "db:schema": "npm run db:schema --workspace @hyperzod/backend-server",
    "db:seed": "npm run db:seed --workspace @hyperzod/backend-server",

    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
